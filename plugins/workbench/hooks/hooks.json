{
  "description": "workbench: names the live effort directory when a workbench skill is invoked. Requires node on PATH; silent when docs/plan/ holds no effort directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workbench-effort.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^workbench:",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workbench-effort.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
