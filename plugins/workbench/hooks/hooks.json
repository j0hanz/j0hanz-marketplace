{
  "description": "Briefs the live docs/plan effort directory when a workbench skill runs. Requires node on PATH; without it the hook is inert and skills still run.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workbench-effort.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workbench-effort.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
