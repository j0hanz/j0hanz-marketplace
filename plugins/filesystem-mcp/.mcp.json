{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "--prefix", "${CLAUDE_PLUGIN_ROOT}", "@j0hanz/filesystem-mcp@2.7.2", "--allow-cwd", "--root-boundary", "."],
      "env": {
        "FS_PORT": "",
        "FS_ALLOWED_DIRS": "",
        "FS_ALLOW_CWD_WALK": "false",
        "FS_ALLOW_MISSING_ROOTS": "false",
        "FS_ALLOW_SENSITIVE": "false"
      }
    }
  }
}
