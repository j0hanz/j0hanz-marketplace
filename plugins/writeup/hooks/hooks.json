{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|create|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.mjs\"",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/scan.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.mjs\" commit",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/scan.mjs\" commit",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.mjs\" pr",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/scan.mjs\" pr",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.mjs\"",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/scan.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
