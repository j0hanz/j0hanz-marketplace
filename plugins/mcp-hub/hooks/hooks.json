{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|new",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.cjs\"",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-start.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|create|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.cjs\"",
            "powershell": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/post-tool-use.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
