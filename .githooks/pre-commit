#!/usr/bin/env bash
# Formats staged files with prettier and re-stages them, so format:check never fails at the gate.
# shortcut: re-stages whole files, so a partly staged file gets its unstaged hunks committed too;
# switch to lint-staged if partial staging becomes common.
set -e
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM)
[ ${#files[@]} -eq 0 ] && exit 0
npx --no-install prettier --write --ignore-unknown --log-level warn "${files[@]}"
git add -- "${files[@]}"
