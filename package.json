{
  "name": "j0hanz-marketplace",
  "private": true,
  "description": "Dev tooling for the marketplace. Plugin metadata lives in each plugins/<name>/.claude-plugin/plugin.json.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "site:data": "node scripts/build-site-data.mjs",
    "check": "npm run format:check && npm run validate && npm run typecheck && npm test",
    "site:dev": "npm run site:data && vite",
    "site:build": "npm run site:data && vite build",
    "typecheck": "npm run site:data && tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
