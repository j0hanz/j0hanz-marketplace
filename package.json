{
  "name": "j0hanz-marketplace",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the marketplace. Plugin metadata lives in each plugins/<name>/.claude-plugin/plugin.json.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"scripts/*.test.mjs\" \"plugins/*/test/**/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "site:data": "node scripts/build-site-data.mjs",
    "check": "npm run lint && npm run format:check && npm run validate && npm run typecheck && npm test",
    "site:dev": "npm run site:data && vite",
    "site:build": "npm run site:data && vite build",
    "typecheck": "npm run site:data && tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.2",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mui/material": "^9.5.0",
    "react": "^19",
    "react-dom": "^19"
  }
}
